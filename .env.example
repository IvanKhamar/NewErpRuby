# Copy this file to .env and change what you need. .env is git-ignored, so it never reaches GitHub.
# Every value here is a local development value or empty. Real keys go only into your own .env.

# MySQL from docker compose (port 3327 on the host, so it does not clash with a local MySQL on 3306).
NEWERP_DB_HOST=localhost
NEWERP_DB_PORT=3327
NEWERP_DB_NAME=newerp_ruby_dev
NEWERP_DB_USER=newerp
NEWERP_DB_PASSWORD=newerp_dev_password
NEWERP_DB_ROOT_PASSWORD=root_dev_password

REDIS_URL=redis://redis:6379/0

# Rails signs and encrypts cookies with this key. Generate your own: bin/rails secret
SECRET_KEY_BASE=

# Kafka for order events; empty: events only go to the log.
#NEWERP_KAFKA_BROKERS=kafka:9092

# Outside services. Empty: a stub answers (or a clear "not configured" message), so local work never reaches a
# real service. Put real keys only into your own .env.
#NEWERP_NOVA_POSHTA_API_KEY=
#NEWERP_NOVA_POST_API_KEY=
#NEWERP_NOVA_POST_SANDBOX=1
#NEWERP_NOVA_POST_SENDER={"name":"Shop","phone":"380000000000","email":"shop@example.com","city":"Kyiv","street":"Example st.","postCode":"01001","building":"1","flat":""}
#NEWERP_LIQPAY_PUBLIC_KEY=
#NEWERP_LIQPAY_PRIVATE_KEY=
#NEWERP_PRIVATBANK_ACCOUNT_ID=
#NEWERP_PRIVATBANK_TOKEN=
#NEWERP_CHECKBOX_CASHIERS=[{"cashierId":1,"login":"","password":"","licenseKey":""}]
#NEWERP_SMSCLUB_TOKEN=
